generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String             @id @default(cuid())
  name                  String
  email                 String             @unique
  password              String
  role                  Role
  status                Status             @default(ACTIVE)
  profileImage          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  attendanceRecords     AttendanceRecord[]
  taughtCourses         Course[]           @relation("TeacherCourses")
  sentMessages          CourseMessage[]
  enrollments           Enrollment[]
  notificationsReceived Notification[]
  notificationReads     NotificationRead[]
  submissions           Submission[]
}

model Course {
  id           String             @id @default(cuid())
  title        String
  description  String
  meetingLink  String?
  thumbnail    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  teacherId    String
  assignments  Assignment[]
  attendance   AttendanceRecord[]
  teacher      User               @relation("TeacherCourses", fields: [teacherId], references: [id])
  messages     CourseMessage[]
  resources    CourseResource[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]
}

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  studentId String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model Assignment {
  id           String       @id @default(cuid())
  title        String
  instructions String
  dueDate      DateTime
  createdAt    DateTime     @default(now())
  courseId     String
  totalMarks   Int          @default(10)
  course       Course       @relation(fields: [courseId], references: [id])
  submissions  Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  response     String
  status       SubmissionStatus @default(SUBMITTED)
  grade        String?
  feedback     String?
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  fileType     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  studentId    String
  assignmentId String
  earnedMarks  Int?
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  student      User             @relation(fields: [studentId], references: [id])

  @@unique([studentId, assignmentId])
}

model LiveSession {
  id                   String             @id @default(cuid())
  title                String
  startsAt             DateTime
  link                 String
  createdAt            DateTime           @default(now())
  courseId             String
  endsAt               DateTime?
  hostLink             String?
  checkInCode          String?
  checkInCodeExpiresAt DateTime?
  attendanceRecords    AttendanceRecord[]
  course               Course             @relation(fields: [courseId], references: [id])
}

model CourseResource {
  id          String   @id @default(cuid())
  title       String
  description String
  fileUrl     String
  fileName    String
  fileSize    Int
  fileType    String
  createdAt   DateTime @default(now())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  date              DateTime         @default(now())
  status            AttendanceStatus
  studentId         String
  courseId          String
  attendedAt        DateTime?
  durationMinutes   Int?
  leftAt            DateTime?
  liveSessionId     String?
  notes             String?
  verifiedByTeacher Boolean          @default(false)
  course            Course           @relation(fields: [courseId], references: [id])
  liveSession       LiveSession?     @relation(fields: [liveSessionId], references: [id])
  student           User             @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId, date])
}

model Notification {
  id          String               @id @default(cuid())
  title       String
  message     String
  audience    NotificationAudience
  createdAt   DateTime             @default(now())
  recipientId String?
  recipient   User?                @relation(fields: [recipientId], references: [id])
  readBy      NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(cuid())
  readAt         DateTime     @default(now())
  userId         String
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, notificationId])
}

model CourseMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  senderId  String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum NotificationAudience {
  ALL
  STUDENT
  TEACHER
  ADMIN
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
